# Inhalt für .streamlit/secrets.toml (lokal) bzw. "Secrets" in den Streamlit-Cloud-App-Einstellungen.
# Diese Datei NICHT mit echten Werten auf GitHub hochladen (secrets.toml gehört in .gitignore).

[journal]
# Optional, aber online Pflicht: Postgres-URL (z. B. Supabase → Project Settings → Database → Connection string)
# Ohne Eintrag wird lokal data/trading_journal.db (SQLite) benutzt.
db_url = "postgresql+psycopg2://postgres:PASSWORT@db.XXXX.supabase.co:5432/postgres"

# Optional: Passwortschutz für das Journal auf deiner öffentlichen Seite
password = "dein-journal-passwort"

[metaapi]
# Token von app.metaapi.cloud → API access
token = "DEIN_METAAPI_TOKEN"
