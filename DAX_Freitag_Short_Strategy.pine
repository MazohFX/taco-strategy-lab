//@version=6
// ============================================================================
// DAX Freitag-Short (Intraday)
// ----------------------------------------------------------------------------
// Jeden Freitag zur Einstiegszeit (Europe/Berlin) Short, am selben Freitag zur
// Ausstiegszeit wieder raus. Kein Halten über das Wochenende.
// Getestet für GER40/GER30-CFDs auf M15 und H1.
// ============================================================================
strategy("DAX Freitag Short (Berlin-Zeit)", shorttitle = "DAX Fr Short", overlay = true,
     initial_capital          = 10000,
     default_qty_type         = strategy.fixed,
     default_qty_value        = 1,
     // Kommission und Slippage bleiben im Eigenschaften-Dialog frei einstellbar
     commission_type          = strategy.commission.cash_per_contract,
     commission_value         = 0.0,
     slippage                 = 0,
     // CFD-Hebel 20:1 → 5 % Margin (sonst lehnt der Tester 1 Kontrakt bei 10k Kapital ab)
     margin_long              = 5,
     margin_short             = 5,
     process_orders_on_close  = false,
     calc_on_every_tick       = false,
     max_labels_count         = 500)

// ============================================================================
// Konstanten
// ============================================================================
const string TZ      = "Europe/Berlin"
const string G_TIME  = "Zeit (Europe/Berlin)"
const string G_RISK  = "Risiko"
const string G_COST  = "Kosten"
const string G_BT    = "Backtest"
const string ID_SHORT = "Short"

// ============================================================================
// Inputs
// ============================================================================
entryH = input.int(8,  "Einstieg Stunde", minval = 0, maxval = 23,       group = G_TIME, inline = "en")
entryM = input.int(0,  "Minute",          options = [0, 15, 30, 45],      group = G_TIME, inline = "en")
exitH  = input.int(21, "Ausstieg Stunde", minval = 0, maxval = 23,        group = G_TIME, inline = "ex")
exitM  = input.int(0,  "Minute",          options = [0, 15, 30, 45],      group = G_TIME, inline = "ex")

slOn   = input.bool(true, "Stop Loss aktiv", group = G_RISK)
slPct  = input.float(0.50, "Stop Loss (%)", group = G_RISK,
     options = [0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80,
                0.85, 0.90, 0.95, 1.00, 1.05, 1.10, 1.15, 1.20, 1.25, 1.30, 1.35, 1.40, 1.45,
                1.50, 1.55, 1.60, 1.65, 1.70, 1.75, 1.80, 1.85, 1.90, 1.95, 2.00])
qty    = input.float(1.0, "Positionsgröße (Kontrakte)", minval = 0.01, step = 0.1, group = G_RISK)

spreadPts = input.float(1.0, "Spread in Punkten", minval = 0.0, step = 0.1, group = G_COST,
     tooltip = "Wird je zur Hälfte beim Entry und beim Exit angerechnet (Chartkurs = Mid). " +
               "Kommission und Slippage im Eigenschaften-Dialog der Strategie einstellen.")

startT = input.time(timestamp("01 Jan 2018 00:00 +0100"), "Start", group = G_BT)
endT   = input.time(timestamp("31 Dec 2030 23:59 +0100"), "Ende",  group = G_BT)

// ============================================================================
// Zeit-Hilfsfunktionen (alles in Europe/Berlin, inkl. Sommer-/Winterzeit)
// ============================================================================
// Unix-Zeitstempel für hh:mm Berliner Zeit am Berliner Kalendertag von t
f_ts(int t, int h, int m) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), h, m, 0)

// Eindeutiger Tages-Schlüssel (JJJJMMTT) in Berliner Zeit
f_dayKey(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

// ----------------------------------------------------------------------------
// Kostenmodell Spread:
//   Chartkurs wird als Mid angenommen.
//   Short-Entry  → Verkauf zum Bid  = Fill - Spread/2   (effektiver Einstieg)
//   Exit         → Kauf zum Ask     = Fill + Spread/2   (effektiver Ausstieg)
//   → pro Round-Trip kostet ein Trade genau 1× Spread × Kontrakte × Punktwert.
//   Der SL ist ein Ask-Level: effEntry × (1 + SL%). Auf dem (Mid-)Chart löst er
//   daher schon Spread/2 früher aus. So verliert ein SL-Treffer netto genau SL %.
//   Kommission + Slippage rechnet der Strategy-Tester selbst (strategy()-Parameter),
//   der Spread fließt in die Tabelle ein (Tester kann Fill-Preise nicht verschlechtern).
// ----------------------------------------------------------------------------
// SL-Abstand in Ticks relativ zum Fill-Kurs (für strategy.exit(loss=...))
f_slTicks(float fill) =>
    float effEntry = fill - spreadPts / 2.0
    float slAsk    = effEntry * (1.0 + slPct / 100.0)
    float slChart  = slAsk - spreadPts / 2.0
    math.max(1, int(math.round((slChart - fill) / syminfo.mintick)))

// ============================================================================
// Validierung
// ============================================================================
int  entryMin     = entryH * 60 + entryM
int  exitMin      = exitH  * 60 + exitM
bool timesValid   = exitMin > entryMin
int  tfMin        = timeframe.isintraday ? int(timeframe.in_seconds() / 60) : 0
bool tfOk         = timeframe.isintraday and tfMin > 0
bool entryAligned = tfOk and entryMin % tfMin == 0
bool exitAligned  = tfOk and exitMin  % tfMin == 0

// ============================================================================
// Einstiegslogik
// ----------------------------------------------------------------------------
// Market-Orders werden bei process_orders_on_close=false am Open der NÄCHSTEN
// Kerze gefüllt. Deshalb wird das Signal auf der Kerze VOR der Einstiegszeit
// ausgelöst: time_close dieser Kerze = Startzeit der nächsten Kerze.
// Beispiel M15, 08:00: Signal auf 07:45-Kerze → Fill am Open der 08:00-Kerze.
// Beispiel H1,  08:00: Signal auf 07:00-Kerze → Fill am Open der 08:00-Kerze.
// ============================================================================
int  nextBarStart = time_close
int  entryTsNext  = f_ts(nextBarStart, entryH, entryM)
int  dayKeyNext   = f_dayKey(nextBarStart)
bool isFriNext    = dayofweek(nextBarStart, TZ) == dayofweek.friday
bool inWindow     = nextBarStart >= startT and nextBarStart <= endT

var int lastTradeDay   = 0     // max. 1 Trade pro Freitag
var int plannedEntryTs = 0     // erwartete Startzeit der Fill-Kerze
var int plannedExitTs  = 0     // Ausstiegszeit des laufenden Trades

bool entrySignal = timesValid and entryAligned and inWindow and isFriNext
     and nextBarStart == entryTsNext
     and not session.islastbar            // nächste Kerze liegt in derselben Session
     and strategy.position_size == 0
     and lastTradeDay != dayKeyNext
     and barstate.isconfirmed

if entrySignal
    lastTradeDay   := dayKeyNext
    plannedEntryTs := entryTsNext
    plannedExitTs  := f_ts(nextBarStart, exitH, exitM)
    strategy.entry(ID_SHORT, strategy.short, qty = qty, comment = "Short")
    // SL sofort mitsenden, damit er schon auf der Fill-Kerze aktiv ist.
    // loss= ist relativ zum echten Fill; Abstand vorläufig aus close berechnet.
    if slOn
        strategy.exit("SL", from_entry = ID_SHORT, loss = f_slTicks(close), comment = "SL")

// ============================================================================
// Ausstiegslogik
// ============================================================================
bool isShort     = strategy.position_size < 0
bool justEntered = isShort and nz(strategy.position_size[1]) >= 0

if justEntered and time != plannedEntryTs
    // Datenlücke: Fill-Kerze ist nicht die Einstiegskerze → Trade sofort verwerfen
    // (wird in der Statistik nicht mitgezählt)
    strategy.close(ID_SHORT, comment = "Gap", immediately = true)
else if isShort
    // SL auf den exakten Einstiegskurs nachziehen
    if slOn
        strategy.exit("SL", from_entry = ID_SHORT, loss = f_slTicks(strategy.position_avg_price), comment = "SL")

    bool notFriday   = dayofweek(time, TZ) != dayofweek.friday
    bool exitReached = time_close >= plannedExitTs

    if notFriday
        // Darf nie passieren – Notbremse, falls doch über Nacht/Wochenende gehalten
        strategy.close(ID_SHORT, comment = "Notfall", immediately = true)
    else if session.islastbar
        // Letzte Kerze der Freitags-Session: zum Close DIESER Kerze schließen,
        // sonst würde die Order erst am Montag-Open gefüllt
        strategy.close(ID_SHORT, comment = exitReached ? "Zeit" : "Sicherheit", immediately = true)
    else if exitReached
        // Zeit-Exit: Fill am Open der Kerze, die zur Ausstiegszeit beginnt
        strategy.close(ID_SHORT, comment = "Zeit")

// ============================================================================
// Statistik (netto inkl. Spread, Kommission, Slippage)
// ============================================================================
var int   processed  = 0
var int   nTrades    = 0
var int   nWins      = 0
var int   nLosses    = 0
var int   nSL        = 0
var int   nTime      = 0
var int   nSafety    = 0
var int   nGap       = 0
var float grossWin   = 0.0
var float grossLoss  = 0.0
var float sumWinPct  = 0.0
var float sumLossPct = 0.0
var float cumNet     = 0.0
var float peakEq     = strategy.initial_capital
var float maxDD      = 0.0
var float maxDDPct   = 0.0

while processed < strategy.closedtrades
    int    i      = processed
    string why    = strategy.closedtrades.exit_comment(i)
    float  tQty   = math.abs(strategy.closedtrades.size(i))
    float  entryP = strategy.closedtrades.entry_price(i)
    // profit() enthält bereits Kommission + Slippage; Spread hier abziehen
    float  net    = strategy.closedtrades.profit(i) - spreadPts * tQty * syminfo.pointvalue
    float  pct    = net / (entryP * tQty * syminfo.pointvalue) * 100.0

    if why == "Gap"
        nGap += 1
    else
        nTrades += 1
        if net > 0
            nWins     += 1
            grossWin  += net
            sumWinPct += pct
        else
            nLosses    += 1
            grossLoss  += -net
            sumLossPct += pct
        if why == "SL"
            nSL += 1
        else if why == "Zeit"
            nTime += 1
        else
            nSafety += 1

        // Drawdown auf Basis der Netto-Equity (abgeschlossene Trades)
        cumNet  += net
        float eq = strategy.initial_capital + cumNet
        peakEq  := math.max(peakEq, eq)
        float dd = peakEq - eq
        if dd > maxDD
            maxDD    := dd
            maxDDPct := dd / peakEq * 100.0

        // Exit-Marker
        color  lblCol = why == "SL" ? color.red : why == "Zeit" ? color.blue : color.orange
        label.new(strategy.closedtrades.exit_bar_index(i), strategy.closedtrades.exit_price(i),
             why + "\n" + str.tostring(pct, "0.00") + " %",
             style = label.style_label_up, color = lblCol, textcolor = color.white, size = size.tiny)
    processed += 1

// ============================================================================
// Visualisierung
// ============================================================================
float entryLine = isShort ? strategy.position_avg_price : na
float slLine    = isShort and slOn ? strategy.position_avg_price + f_slTicks(strategy.position_avg_price) * syminfo.mintick : na
plot(entryLine, "Entry",     color.blue, 2, plot.style_linebr)
plot(slLine,    "Stop Loss", color.red,  2, plot.style_linebr)
bgcolor(isShort ? color.new(color.red, 88) : na, title = "Position offen")

// Statistik-Tabelle
var table stats = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15),
     border_color = color.gray, border_width = 1, frame_color = color.gray, frame_width = 1)

f_row(int r, string k, string v) =>
    table.cell(stats, 0, r, k, text_color = color.white, text_halign = text.align_left,  text_size = size.small)
    table.cell(stats, 1, r, v, text_color = color.white, text_halign = text.align_right, text_size = size.small)

if barstate.islast
    float winrate = nTrades > 0 ? float(nWins) / nTrades * 100.0 : na
    string pf     = grossLoss > 0 ? str.tostring(grossWin / grossLoss, "0.00") : nTrades > 0 ? "∞" : "–"
    float avgWin  = nWins   > 0 ? sumWinPct  / nWins   : na
    float avgLoss = nLosses > 0 ? sumLossPct / nLosses : na

    table.cell(stats, 0, 0, "DAX Fr Short (netto inkl. Spread)", text_color = color.yellow, text_size = size.small)
    table.merge_cells(stats, 0, 0, 1, 0)
    f_row(1, "Trades",              str.tostring(nTrades))
    f_row(2, "Winrate",             na(winrate) ? "–" : str.tostring(winrate, "0.0") + " %")
    f_row(3, "Profit Factor",       pf)
    f_row(4, "Ø Gewinn",            na(avgWin)  ? "–" : str.tostring(avgWin,  "0.00") + " %")
    f_row(5, "Ø Verlust",           na(avgLoss) ? "–" : str.tostring(avgLoss, "0.00") + " %")
    f_row(6, "SL / Zeit / Sicher.", str.tostring(nSL) + " / " + str.tostring(nTime) + " / " + str.tostring(nSafety))
    f_row(7, "Max Drawdown",        str.tostring(maxDD, "#,##0.00") + " (" + str.tostring(maxDDPct, "0.00") + " %)")
    f_row(8, "Netto / Gap-Abbr.",   str.tostring(cumNet, "#,##0.00") + " / " + str.tostring(nGap))

// Warnungen
var table warn = table.new(position.top_center, 1, 1)

if barstate.islast
    string w = ""
    if not timesValid
        w += "⚠ Ausstiegszeit ≤ Einstiegszeit – es wird NICHT gehandelt.\n"
    if not tfOk
        w += "⚠ Nur Intraday-Timeframes (M15/H1) werden unterstützt.\n"
    else
        if not entryAligned
            w += "⚠ Einstiegszeit " + str.format("{0,number,00}:{1,number,00}", entryH, entryM) +
                 " passt nicht zum Timeframe (" + str.tostring(tfMin) + " min) – keine Trades.\n"
        if not exitAligned
            w += "⚠ Ausstiegszeit " + str.format("{0,number,00}:{1,number,00}", exitH, exitM) +
                 " passt nicht zum Timeframe – Exit erst mit der folgenden Kerze.\n"
    if w != ""
        table.cell(warn, 0, 0, str.substring(w, 0, str.length(w) - 1),
             bgcolor = color.new(color.red, 10), text_color = color.white, text_size = size.normal)
    else
        table.clear(warn, 0, 0)
